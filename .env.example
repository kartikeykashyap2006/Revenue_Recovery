RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
ANTHROPIC_API_KEY=your_anthropic_key

# Which LLM backend app/integrations/llm.py calls: "anthropic" (default, needs
# ANTHROPIC_API_KEY + billing) or "nvidia" (NVIDIA's hosted NIM API running a
# free Nemotron model, key from https://build.nvidia.com, ~40 RPM free tier).
LLM_PROVIDER=anthropic
NVIDIA_API_KEY=your_nvidia_key
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Fastest cadence the client will try for NVIDIA requests. It's an aspiration,
# not a fixed pace: the throttle backs off on a 429 or 503 "worker full" and
# recovers toward this. Higher = exploit an uncongested worker more; the
# backpressure keeps a busy one from being hammered regardless.
NVIDIA_MAX_RPM=60
USE_LIVE_RAZORPAY=false
USE_LLM_DIAGNOSIS=false
USE_AI_RECOVERY_AGENT=false
# Agent consultations issued in parallel (model calls dominate batch runtime).
AI_AGENT_MAX_CONCURRENCY=6

MAX_CONTACT_ATTEMPTS=3
COOLDOWN_HOURS_BETWEEN_ATTEMPTS=24
QUIET_HOURS_START=21
QUIET_HOURS_END=9
HIGH_VALUE_ESCALATION_THRESHOLD=50000
