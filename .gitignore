.env
__pycache__/
*.pyc
.venv/
venv/
*.db
.DS_Store
# A pattern containing a slash is anchored to this file's directory, so
# `reports/*.json` would only ever match at the repo root -- and the
# generated reports now live in backend/reports/.
**/reports/*.json
**/reports/*.html
# Generated deliverables, not sources: the dashboard is rebuilt from the audit
# trail by scripts/build_dashboard.py, and the share zip is produced by
# `git archive` -- committing either bloats the repo (and a committed zip ends
# up inside the next zip).
*.zip
audit_log.jsonl
state.json
audit_trail.db
audit_trail.db-journal

# Frontend build output and deps (frontend/.gitignore covers these too; kept
# here so a checkout from the repo root never stages them by accident).
node_modules/
frontend/dist/
